# Timezone dates/times are displayed in (an IANA name, e.g. America/New_York,
# Europe/London). All dates on every page are rendered server-side, so
# without this the container defaults to UTC regardless of where you or the
# server physically are.
TZ=America/New_York

# Auth.js / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Running behind Cloudflare Tunnel (a reverse proxy) — required so Auth.js
# trusts the forwarded host/proto instead of rejecting the request.
AUTH_TRUST_HOST=true
# Public URL of the app, used to build absolute callback URLs.
AUTH_URL=https://tesla.hidbox.net

# Single-user login for this app (not your Tesla/TeslaMate credentials).
# Pick a strong password — this app is reachable from the public internet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# TeslaMate's Postgres database. Use a read-only user (see README) —
# this app never writes to the database.
TESLAMATE_DB_HOST=
TESLAMATE_DB_PORT=5432
TESLAMATE_DB_NAME=teslamate
TESLAMATE_DB_USER=flux_cascade_ro
TESLAMATE_DB_PASSWORD=
# Set to "true" only if your Postgres requires SSL.
TESLAMATE_DB_SSL=false
